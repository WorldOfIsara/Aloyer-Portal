---
const title = 'Willkommen in Aloy';
const description = 'Einstieg in das Aloy Portal.';

// Entfernt den abschließenden Schrägstrich.
// Aus "/Aloyer-Portal/" wird dadurch "/Aloyer-Portal".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link
      rel="icon"
      type="image/png"
      href={`${base}/logos/haubentaucher-wappen-transparent.png?v=2`}
    />
  </head>

  <body>
    <div class="hero-fog" aria-hidden="true">
      <span class="fog-blob fog-blob-1"></span>
      <span class="fog-blob fog-blob-2"></span>
      <span class="fog-blob fog-blob-3"></span>
    </div>

    <div class="vignette" aria-hidden="true"></div>

    <div class="hero-embers" data-embers aria-hidden="true"></div>

    <main class="splash">
      <a
        class="logo-link logo-stamp"
        href={`${base}/ot/willkommen`}
        aria-label="Zum Portal"
      >
        <img
          src={`${base}/logos/wappen-aloy-full-clean.png`}
          alt="Aloy Wappen"
          class="logo"
        />
      </a>

      <p class="intro reveal reveal-2">
        Willkommen bei den Aloyer Söldnern
        <span>und am Ohmer Grenztor!</span>
      </p>

      <div class="cta-row reveal reveal-3">
        <a
          class="enter-btn"
          href={`${base}/ot/willkommen`}
        >
          <span>Aloy betreten</span>

          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </main>

    <script>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Funken: ein paar kleine Punkte, die von unten nach oben durchs
        // Bild treiben, jeweils mit eigener Größe/Dauer/Startverzögerung.
        // Läuft immer, außer bei reduzierter Bewegung.
        if (!reduceMotion) {
          const emberLayer = document.querySelector('[data-embers]');
          if (emberLayer instanceof HTMLElement) {
            const emberCount = 34;
            for (let i = 0; i < emberCount; i += 1) {
              const ember = document.createElement('span');
              ember.className = 'ember';
              const size = 3 + Math.random() * 5;
              ember.style.left = `${5 + Math.random() * 90}%`;
              ember.style.width = `${size}px`;
              ember.style.height = `${size}px`;
              ember.style.setProperty('--ember-drift', `${Math.random() * 60 - 30}px`);
              ember.style.animationDuration = `${5 + Math.random() * 5}s`;
              ember.style.animationDelay = `${Math.random() * 8}s`;
              emberLayer.appendChild(ember);
            }
          }
        }
      })();
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    font-family: 'Alegreya', 'Georgia', serif;
    color: #1f120b;
    background: #140b07;
    overflow: hidden;
  }

  /* Screen-Shake im Moment des Einschlags: startet, wenn das fallende
     Wappen auf seiner Endposition in der Bildmitte aufschlägt (siehe
     .logo-stamp/@keyframes stamp - Einschlag bei 75% von 1300ms +
     100ms Delay = 1075ms), noch bevor es nachfedert. Läuft auf body,
     damit Hintergrund/Nebel/Funken/Text wirklich ALLES gemeinsam
     wackelt statt nur das Wappen. */
  body {
    animation: hero-shake 420ms cubic-bezier(0.36, 0.07, 0.19, 0.97) 1075ms both;
  }

  /*
    Hero-Ebenen von hinten nach vorn: .hero-fog (treibender Nebel) >
    .vignette (Abdunklung an den Rändern) > .hero-embers (aufsteigende
    Funken). Der Hintergrund selbst ist die einfarbige body-Fläche
    (kein Foto mehr).
  */

  /* Treibender Nebel: zwei-drei weiche, unscharfe Streifen, die langsam
     von links nach rechts durchs Bild ziehen. */
  .hero-fog {
    position: fixed;
    inset: 0;
    z-index: -3;
    overflow: hidden;
    pointer-events: none;
  }

  /* Größer, flacher in der Deckkraft und viel stärker verwaschen als
     vorher - sonst liest sich ein schmaler, scharf begrenzter Blob als
     Lichtschliere statt als Nebel/Dunst. */
  .fog-blob {
    position: absolute;
    left: -45%;
    width: 90%;
    height: 260px;
    background: rgba(230, 210, 180, 0.045);
    filter: blur(50px);
    border-radius: 50%;
  }

  .fog-blob-1 {
    top: 20%;
    animation: fogDrift 30s linear infinite;
  }

  .fog-blob-2 {
    top: 50%;
    height: 220px;
    background: rgba(230, 210, 180, 0.035);
    animation: fogDrift 38s linear infinite;
    animation-delay: -14s;
  }

  .fog-blob-3 {
    top: 78%;
    height: 200px;
    background: rgba(230, 210, 180, 0.03);
    animation: fogDrift 34s linear infinite reverse;
  }

  .vignette {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;

    background:
      radial-gradient(
        120% 80% at 50% 42%,
        transparent 52%,
        rgba(12, 8, 6, 0.55) 100%
      );
  }

  /* Aufsteigende Funken - Punkte werden per Script befüllt (siehe unten),
     jeder mit eigener Animationsdauer/-verzögerung. */
  .hero-embers {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-embers :global(.ember) {
    position: absolute;
    bottom: -2%;
    border-radius: 50%;
    background: rgba(255, 190, 120, 0.98);
    box-shadow:
      0 0 8px rgba(255, 170, 90, 0.9),
      0 0 18px rgba(255, 140, 60, 0.55);
    animation-name: emberRise;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .splash {
    min-height: 100vh;
    min-height: 100dvh;

    display: grid;
    place-items: center;
    align-content: center;
    gap: 1.1rem;

    padding: 1.2rem;
    text-align: center;
  }

  .logo-link {
    display: inline-block;
    border-radius: 20px;
    transition: transform 260ms ease;
  }

  .logo-link:hover,
  .logo-link:focus-visible {
    transform: scale(1.03);
  }

  /* Wappen fällt von oben ins Bild und schlägt auf seiner Endposition
     (Bildmitte) auf, statt einzufaden. Timing/Beschleunigung steckt in
     den Keyframe-Abständen selbst (siehe @keyframes stamp), deshalb hier
     nur noch "ease" statt einer speziellen Bezier-Kurve. opacity bleibt
     bewusst konstant bei 1 (nur transform animiert) - falls die
     Animation aus irgendeinem Grund nicht greift, bleibt das Wappen
     trotzdem sichtbar statt zu verschwinden. */
  .logo-stamp {
    opacity: 1;
    animation: stamp 1300ms ease 100ms forwards;
  }

  .logo {
    display: block;
    width: min(78vw, 560px);
    max-height: 66vh;
    object-fit: contain;

    filter:
      drop-shadow(0 24px 36px rgba(52, 38, 26, 0.34))
      drop-shadow(0 8px 16px rgba(127, 47, 31, 0.25));
  }

  .intro {
    margin: 0;
    padding: 0.4rem 0;

    color: #fff9ef;

    text-shadow:
      0 2px 12px rgba(0, 0, 0, 0.72),
      0 1px 2px rgba(0, 0, 0, 0.9);

    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.5;
    font-weight: 600;
  }

  .intro span {
    display: block;
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .cta-row {
    margin-top: 0.4rem;
  }

  .enter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;

    padding: 0.72rem 1.5rem;
    border: 1px solid rgba(250, 238, 210, 0.35);
    border-radius: 999px;

    font-family: 'Source Sans 3', 'Segoe UI', sans-serif;
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: 0.01em;
    text-decoration: none;

    color: #fff6ea;
    background: linear-gradient(120deg, #7f2f1f, #9f4827);

    box-shadow:
      0 10px 26px rgba(20, 11, 7, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);

    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .enter-btn svg {
    transition: transform 180ms ease;
  }

  .enter-btn:hover,
  .enter-btn:focus-visible {
    transform: translateY(-2px);

    box-shadow:
      0 16px 34px rgba(20, 11, 7, 0.58),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  .enter-btn:hover svg,
  .enter-btn:focus-visible svg {
    transform: translateX(4px);
  }

  /* Gestaffeltes Einblenden */
  .reveal {
    opacity: 0;
    transform: translateY(16px);

    animation:
      rise 900ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .reveal-1 {
    animation-delay: 120ms;
  }

  .reveal-2 {
    animation-delay: 480ms;
  }

  .reveal-3 {
    animation-delay: 780ms;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fogDrift {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(220%);
    }
  }

  @keyframes emberRise {
    0% {
      transform: translateY(0) translateX(0);
      opacity: 0;
    }

    12% {
      opacity: 0.9;
    }

    100% {
      transform: translateY(-100vh) translateX(var(--ember-drift, 12px));
      opacity: 0;
    }
  }

  /* Fall von oben: EIN durchgehender Zug von 0% auf 75% ohne
     Zwischen-Haltepunkte. Jede Etappe bekommt ihre eigene, zur
     Bewegungsrichtung passende Timing-Funktion direkt im Keyframe
     (animation-timing-function gilt jeweils für die Strecke BIS zum
     nächsten Keyframe) - dadurch wirkt es als eine durchgehende
     Bewegung statt Bremsen + erneutem Beschleunigen:
     0%->75%  beschleunigender Fall (ease-in-artige Kurve)
     75%->87% abbremsendes Nachfedern nach oben (ease-out)
     87%->100% wieder beschleunigend zurück auf die Ruheposition (ease-in)
     Bei 75% erreicht das Wappen seine Endposition in der Bildmitte -
     hier setzt exakt der Screen-Shake ein (siehe body-Regel oben). */
  @keyframes stamp {
    0% {
      transform: translateY(-70vh);
      animation-timing-function: cubic-bezier(0.55, 0.06, 0.68, 0.19);
    }

    75% {
      transform: translateY(0);
      animation-timing-function: ease-out;
    }

    87% {
      transform: translateY(-18px);
      animation-timing-function: ease-in;
    }

    100% {
      transform: translateY(0);
    }
  }

  @keyframes hero-shake {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }

    12% {
      transform: translate(-12px, 7px) rotate(-1.1deg);
    }

    26% {
      transform: translate(10px, -8px) rotate(1deg);
    }

    40% {
      transform: translate(-9px, 6px) rotate(-0.8deg);
    }

    54% {
      transform: translate(7px, -5px) rotate(0.6deg);
    }

    68% {
      transform: translate(-5px, 4px) rotate(-0.4deg);
    }

    82% {
      transform: translate(3px, -2px) rotate(0.2deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .logo-stamp {
      opacity: 1;
      transform: none;
      animation: none;
    }

    body {
      animation: none;
    }

    .fog-blob {
      animation: none;
      display: none;
    }

    .hero-embers {
      display: none;
    }
  }

  /* Nebel kostet auf schmalen Screens unnötig Leistung und wirkt dort
     kaum - Funken/Glut bleiben bewusst überall an. */
  @media (max-width: 640px) {
    .hero-fog {
      display: none;
    }
  }
</style>
