---
import ItContentPage from '../../components/ItContentPage.astro';
import { itReportEntries } from '../../data/itReports';

const reportYears = [...new Set(itReportEntries.map((entry) => entry.year))];
const latestYear = reportYears.at(-1) ?? '';
const initialEntry = itReportEntries.find((entry) => entry.year === latestYear) ?? itReportEntries[0];

const typeLabels = [
  'Originalbericht',
  'Originalmeldung',
  'Originalausschreibung',
  'Bestätigte Kurzmeldung',
] as const;

const typeKey = (type: string) => {
  if (type === 'Originalbericht') return 'bericht';
  if (type === 'Originalmeldung') return 'meldung';
  if (type === 'Originalausschreibung') return 'ausschreibung';
  return 'kurzmeldung';
};

// "Original" ist in diesem Kontext redundant (jeder Eintrag ist ein
// Originaltext) und wird für die Anzeige entfernt.
const displayType = (type: string) => {
  const stripped = type.replace(/^Original/, '');
  return stripped.charAt(0).toUpperCase() + stripped.slice(1);
};

// Symbole je Quellenart statt farbiger Punkte: Schriftstück (Bericht),
// Umschlag (Meldung), Fähnchen/Ausruf (Ausschreibung), Häkchen-Siegel
// (bestätigte Kurzmeldung).
const typeIcons: Record<string, string> = {
  bericht:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M15 3v4h4"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="15.5" x2="16" y2="15.5"/><line x1="8" y1="19" x2="13" y2="19"/></svg>',
  meldung:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
  ausschreibung:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3v18"/><path d="M5 4h11l-2.5 3.5L16 11H5"/></svg>',
  kurzmeldung:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>',
};

// Leichter Wellenversatz je Eintrag, damit der Zeitstrahl-Pfad (siehe <script>
// unten) nicht schnurgerade, sondern wie ein gewundener Pfad wirkt. Der Punkt
// wird per CSS-Transform verschoben, das Skript zeichnet die Linie danach
// exakt durch die tatsächlichen Punktpositionen.
const waveOffset = (index: number) => Math.round(Math.sin(index * 1.15) * 24);
---

<ItContentPage
  title="Berichte"
  description="Originalberichte, Botenmeldungen und bestätigte Chronikeinträge aus den Registern Aloys."
  wide
>
  <div class="chronicle-intro">
    <p>Die Register der Akademie bewahren Feldberichte, öffentliche Botenmeldungen, Ausschreibungen und bestätigte Ereignisse. Wählet ein Jahr und eine Quellenart, um die Chronik einzugrenzen. Persönliche Berichte zeigen die Sicht ihrer Verfasser und gelten nicht als allwissende Staatschronik.</p>
    <p class="transmission-note">Originaltexte bleiben in ihrer überlieferten Schreibweise erhalten. Ältere Zeitkürzel, Ortsnamen und sprachliche Eigenheiten wurden nicht nachträglich geglättet.</p>
  </div>

  <section class="chronicle" data-chronicle data-initial-year={latestYear} data-initial-entry={initialEntry?.id}>
    <div class="filter-row" aria-label="Registerjahre">
      <span class="filter-label">Jahr</span>
      <button class="filter-chip" type="button" data-year-filter="all" aria-pressed="false">
        Alle
      </button>
      {reportYears.map((year) => (
        <button
          class:list={['filter-chip', { 'is-active': year === latestYear }]}
          type="button"
          data-year-filter={year}
          aria-pressed={year === latestYear ? 'true' : 'false'}
        >
          {year}
        </button>
      ))}
    </div>

    <div class="filter-row" aria-label="Quellenarten">
      <span class="filter-label">Art</span>
      <button class="filter-chip is-active" type="button" data-type-filter="all" aria-pressed="true">
        Alle
      </button>
      {typeLabels.map((type) => (
        <button
          class:list={['filter-chip', `type-${typeKey(type)}`]}
          type="button"
          data-type-filter={type}
          aria-pressed="false"
        >
          <i aria-hidden="true" set:html={typeIcons[typeKey(type)]} />
          {displayType(type)}
        </button>
      ))}
    </div>

    <p class="result-status" data-result-status aria-live="polite"></p>

    <div class="timeline" data-timeline>
      <svg class="timeline-svg" data-timeline-svg aria-hidden="true" preserveAspectRatio="none">
        <path class="timeline-path-bg" data-timeline-path-bg />
        <path class="timeline-path-progress" data-timeline-path-progress />
      </svg>

      <div class="timeline-track" data-entry-list>
        {itReportEntries.map((entry, index) => {
          const entryType = typeKey(entry.type);
          const originalParagraphs = entry.original?.trim().split(/\n\s*\n/) ?? [];

          return (
            <article
              class:list={['timeline-item', `type-${entryType}`, index % 2 === 0 ? 'side-left' : 'side-right']}
              data-entry
              data-entry-id={entry.id}
              data-entry-year={entry.year}
              data-entry-type={entry.type}
              hidden={entry.year !== latestYear}
            >
              <button
                type="button"
                class="timeline-dot"
                data-timeline-dot
                data-timeline-jump
                style={`--wave: ${waveOffset(index)}px`}
                aria-label={`Zu „${entry.title}“ springen`}
                set:html={typeIcons[entryType]}
              ></button>

              <div class="timeline-card">
                <button
                  class="entry-header"
                  type="button"
                  data-entry-toggle
                  aria-expanded="false"
                  aria-controls={`bericht-body-${entry.id}`}
                  id={`bericht-${entry.id}`}
                >
                  <span class="entry-heading">
                    <span class="entry-meta">
                      <span class="entry-year">{entry.year}</span>
                      <span class="entry-type">{displayType(entry.type)}</span>
                    </span>
                    <span class="entry-title">{entry.title}</span>
                  </span>
                  <span class="entry-caret" aria-hidden="true"></span>
                </button>

                <div
                  class="entry-body"
                  id={`bericht-body-${entry.id}`}
                  data-entry-body
                  hidden
                >
                  {entry.facts && (
                    <ul class="confirmed-facts">
                      {entry.facts.map((fact) => <li>{fact}</li>)}
                    </ul>
                  )}

                  {entry.original && (
                    <div class="original-report">
                      <p class="original-label">
                        {(entry.originalLabel ?? 'Originaltext').replace(/\s*lesen\s*$/i, '')}
                      </p>
                      <div class="original-copy">
                        {originalParagraphs.map((paragraph) => <p>{paragraph}</p>)}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <p class="no-results" data-no-results hidden>Für diese Auswahl ist noch keine Akte im Register verzeichnet.</p>
  </section>

  <p class="reports-closing">Weitere bestätigte Rats-, Fest- und Lagerberichte werden aufgenommen, sobald ein belastbarer Eintrag oder ein veröffentlichungsfähiger Originaltext vorliegt. Planungen, unbestätigte Gerüchte und bloße Absichtserklärungen gelten nicht als geschehen.</p>
</ItContentPage>

<script>
  const chronicle = document.querySelector<HTMLElement>('[data-chronicle]');

  if (chronicle) {
    const yearButtons = [...chronicle.querySelectorAll<HTMLButtonElement>('[data-year-filter]')];
    const typeButtons = [...chronicle.querySelectorAll<HTMLButtonElement>('[data-type-filter]')];
    const entries = [...chronicle.querySelectorAll<HTMLElement>('[data-entry]')];
    const resultStatus = chronicle.querySelector<HTMLElement>('[data-result-status]');
    const noResults = chronicle.querySelector<HTMLElement>('[data-no-results]');
    const timeline = chronicle.querySelector<HTMLElement>('[data-timeline]');
    const svg = chronicle.querySelector<SVGSVGElement>('[data-timeline-svg]');
    const pathBg = chronicle.querySelector<SVGPathElement>('[data-timeline-path-bg]');
    const pathProgress = chronicle.querySelector<SVGPathElement>('[data-timeline-path-progress]');

    let selectedYear = chronicle.dataset.initialYear ?? 'all';
    let selectedType = 'all';
    let pathLength = 0;

    // Für jeden sichtbaren Eintrag die Pfadlänge bis zu seinem Punkt (siehe
    // recomputePath). So kann updateProgress erkennen, ob die wachsende Linie
    // eine Kugel schon "erreicht" hat.
    const entryPathLength = new Map<HTMLElement, number>();
    const scratchPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setExpanded = (entry: HTMLElement, expanded: boolean, moveFocus = false) => {
      const toggle = entry.querySelector<HTMLButtonElement>('[data-entry-toggle]');
      const body = entry.querySelector<HTMLElement>('[data-entry-body]');
      toggle?.setAttribute('aria-expanded', String(expanded));
      if (body) body.hidden = !expanded;
      if (expanded && moveFocus) {
        entry.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };

    // Baut aus einer Liste von Punkten einen sanft geschwungenen Pfad
    // (quadratische Kurven durch die Punktmitten) statt einer geraden Linie.
    const buildWindingPath = (points: { x: number; y: number }[]) => {
      if (points.length === 0) return '';
      if (points.length === 1) return `M ${points[0].x} ${points[0].y}`;

      let d = `M ${points[0].x} ${points[0].y}`;

      for (let i = 1; i < points.length - 1; i += 1) {
        const current = points[i];
        const next = points[i + 1];
        const midX = (current.x + next.x) / 2;
        const midY = (current.y + next.y) / 2;
        d += ` Q ${current.x} ${current.y} ${midX} ${midY}`;
      }

      const last = points[points.length - 1];
      d += ` L ${last.x} ${last.y}`;
      return d;
    };

    // Die Füllung des Pfads wächst passend zum Lesefortschritt: sobald die
    // Bildschirmmitte einen Punkt erreicht, ist der Pfad bis dorthin "bereist".
    const updateProgress = () => {
      if (!timeline || !pathProgress || pathLength === 0) return;

      const trackRect = timeline.getBoundingClientRect();
      const trackHeight = trackRect.height || 1;
      const viewportHalf = window.innerHeight * 0.5;

      // Absolute Dokumentposition von Anfang/Ende der Linie sowie die
      // Bildschirmmitte, an der die Linie "vorbeizieht".
      const trackTopAbs = trackRect.top + window.scrollY;
      const trackBottomAbs = trackTopAbs + trackHeight;

      // Rechnerisches Ende (Bildschirmmitte erreicht das Linienende) kann
      // weiter unten liegen, als sich die Seite tatsächlich scrollen lässt
      // (z. B. wenn nach dem Zeitstrahl nur noch ein kurzer Schlusstext und
      // der Footer folgen). Deshalb wird der Endpunkt auf das tatsächlich
      // erreichbare Scroll-Maximum begrenzt - so füllt sich die Linie stetig
      // und ist am Seitenende immer exakt bei 100%, ohne Sprung.
      const maxScrollY = Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight,
      );

      const start = trackTopAbs - viewportHalf;
      const naturalEnd = trackBottomAbs - viewportHalf;
      const end = Math.min(naturalEnd, maxScrollY);

      const span = Math.max(end - start, 1);
      let raw = (window.scrollY - start) / span;
      raw = Math.max(0, Math.min(1, raw));

      pathProgress.style.strokeDashoffset = String(pathLength * (1 - raw));

      // Aktiv ist immer genau die zuletzt erreichte Kugel (die mit der
      // größten Pfadlänge <= aktuellem Füllstand) - nicht ein schmales
      // Abstandsfenster. Ein Fenster kann bei größeren Scroll-Sprüngen
      // (schnelles Mausrad-Scrollen) übersprungen werden, ein "zuletzt
      // erreicht"-Vergleich dagegen nie, egal wie groß der Sprung ist. Ist
      // die zugehörige Karte aufgeklappt, bleibt die Kugel unabhängig davon
      // aktiviert - der Text gehört ja weiterhin zu dieser Kugel.
      const filledLength = pathLength * raw;
      let currentEntry: HTMLElement | null = null;
      let currentLength = -Infinity;
      entryPathLength.forEach((lengthAtEntry, entry) => {
        if (lengthAtEntry <= filledLength && lengthAtEntry > currentLength) {
          currentLength = lengthAtEntry;
          currentEntry = entry;
        }
      });

      entryPathLength.forEach((_lengthAtEntry, entry) => {
        const toggle = entry.querySelector<HTMLButtonElement>('[data-entry-toggle]');
        const isExpanded = toggle?.getAttribute('aria-expanded') === 'true';
        entry.classList.toggle('is-near', isExpanded || entry === currentEntry);
      });
    };

    // Liest die tatsächlichen (bereits durch CSS-Wellenversatz verschobenen)
    // Punktpositionen aus und zeichnet den Pfad neu. Wird bei Filteränderung,
    // Auf-/Zuklappen und Größenänderung erneut aufgerufen.
    const recomputePath = () => {
      if (!timeline || !svg || !pathBg || !pathProgress) return;

      const trackRect = timeline.getBoundingClientRect();
      const width = trackRect.width;
      const height = trackRect.height;
      if (width <= 0 || height <= 0) return;

      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('width', String(width));
      svg.setAttribute('height', String(height));

      const visibleWithPoints = entries
        .filter((entry) => !entry.hidden)
        .map((entry) => {
          const dot = entry.querySelector<HTMLElement>('[data-timeline-dot]');
          if (!dot) return null;
          const dotRect = dot.getBoundingClientRect();
          return {
            entry,
            point: {
              x: dotRect.left - trackRect.left + dotRect.width / 2,
              y: dotRect.top - trackRect.top + dotRect.height / 2,
            },
          };
        })
        .filter((item): item is { entry: HTMLElement; point: { x: number; y: number } } => item !== null);

      const points = visibleWithPoints.map((item) => item.point);

      const d = buildWindingPath(points);
      pathBg.setAttribute('d', d);
      pathProgress.setAttribute('d', d);

      pathLength = pathProgress.getTotalLength();
      pathProgress.style.strokeDasharray = String(pathLength);
      pathProgress.style.strokeDashoffset = String(pathLength);

      // Pfadlänge bis zu jedem einzelnen Punkt ermitteln (für den
      // "Kugel-erreicht"-Effekt in updateProgress), indem der Pfad schrittweise
      // um je einen weiteren Punkt verlängert und neu vermessen wird.
      entryPathLength.clear();
      entries.forEach((entry) => entry.classList.remove('is-near'));
      for (let i = 0; i < visibleWithPoints.length; i += 1) {
        scratchPath.setAttribute('d', buildWindingPath(points.slice(0, i + 1)));
        entryPathLength.set(visibleWithPoints[i].entry, scratchPath.getTotalLength());
      }

      updateProgress();
    };

    let ticking = false;
    const scheduleUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateProgress();
        ticking = false;
      });
    };

    let recomputeTicking = false;
    const scheduleRecompute = () => {
      if (recomputeTicking) return;
      recomputeTicking = true;
      requestAnimationFrame(() => {
        recomputePath();
        recomputeTicking = false;
      });
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleRecompute);
    document.fonts?.ready?.then(scheduleRecompute).catch(() => {});

    if ('ResizeObserver' in window && timeline) {
      const resizeObserver = new ResizeObserver(scheduleRecompute);
      resizeObserver.observe(timeline);
    }

    // Punkte und Karten blenden beim Erscheinen sanft ein. Das "erreicht"-
    // Leuchten der Kugeln wird nicht hierüber, sondern direkt vom
    // Linienfortschritt in updateProgress gesteuert (siehe entryPathLength).
    let revealObserver: IntersectionObserver | undefined;

    if ('IntersectionObserver' in window) {
      revealObserver = new IntersectionObserver(
        (records) => {
          records.forEach((record) => {
            if (record.isIntersecting) {
              record.target.classList.add('is-revealed');
              revealObserver?.unobserve(record.target);
            }
          });
        },
        { threshold: 0.2, rootMargin: '0px 0px -8% 0px' },
      );
    }

    const observeEntry = (entry: HTMLElement) => {
      if (prefersReducedMotion) {
        entry.classList.add('is-revealed');
      } else {
        revealObserver?.observe(entry);
      }
    };

    entries.forEach(observeEntry);

    const applyFilters = () => {
      const visible = entries.filter((entry) => {
        const matchesYear = selectedYear === 'all' || entry.dataset.entryYear === selectedYear;
        const matchesType = selectedType === 'all' || entry.dataset.entryType === selectedType;
        const isVisible = matchesYear && matchesType;
        entry.hidden = !isVisible;
        return isVisible;
      });

      noResults?.toggleAttribute('hidden', visible.length > 0);

      if (resultStatus) {
        const yearText = selectedYear === 'all' ? 'der ganzen Chronik' : selectedYear;
        const typeText = (() => {
          if (selectedType === 'all') return '';
          const stripped = selectedType.replace(/^Original/, '');
          return ` · ${stripped.charAt(0).toUpperCase()}${stripped.slice(1)}`;
        })();
        resultStatus.textContent = `${visible.length} ${visible.length === 1 ? 'Akte' : 'Akten'} aus ${yearText}${typeText}`;
      }

      scheduleRecompute();
    };

    yearButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedYear = button.dataset.yearFilter ?? 'all';
        yearButtons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        applyFilters();
      });
    });

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedType = button.dataset.typeFilter ?? 'all';
        typeButtons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        applyFilters();
      });
    });

    entries.forEach((entry) => {
      const toggle = entry.querySelector<HTMLButtonElement>('[data-entry-toggle]');
      toggle?.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        setExpanded(entry, !isExpanded);
        scheduleRecompute();
      });

      // Klick auf die Kugel springt direkt zur zugehörigen Karte und klappt
      // sie auf, statt nur dekorativ auf der Linie zu sitzen.
      const jumpDot = entry.querySelector<HTMLButtonElement>('[data-timeline-jump]');
      jumpDot?.addEventListener('click', () => {
        setExpanded(entry, true, true);
        scheduleRecompute();
      });
    });

    const hashId = window.location.hash.replace('#bericht-', '');
    const hashEntry = hashId ? entries.find((entry) => entry.dataset.entryId === hashId) : undefined;

    if (hashEntry) {
      selectedYear = 'all';
      const allYearsButton = yearButtons.find((button) => button.dataset.yearFilter === 'all');
      allYearsButton?.click();
      entries.forEach((entry) => setExpanded(entry, entry === hashEntry));
      setExpanded(hashEntry, true, true);
    } else {
      applyFilters();
    }

    scheduleRecompute();
  }
</script>

<style>
  .chronicle-intro {
    display: grid;
    gap: 0.75rem;
    max-width: 760px;
    margin-bottom: var(--space-5);
  }

  .chronicle-intro p {
    margin: 0;
  }

  .transmission-note {
    padding: 0.7rem 0.9rem;
    border-left: 3px solid rgba(159, 72, 39, 0.45);
    color: var(--ink-2);
    font-size: 0.92rem;
    font-style: italic;
  }

  .chronicle {
    margin-top: var(--space-4);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.5rem;
  }

  .filter-row + .filter-row {
    border-top: 1px solid rgba(177, 146, 104, 0.35);
  }

  .filter-label {
    margin-right: 0.25rem;
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(159, 72, 39, 0.35);
    border-radius: 999px;
    color: var(--ink-1);
    background: rgba(253, 247, 236, 0.5);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .filter-chip i {
    display: flex;
    width: 0.95rem;
    aspect-ratio: 1;
    color: var(--type-color, var(--brand-1));
  }

  .filter-chip i :global(svg) {
    width: 100%;
    height: 100%;
  }

  .filter-chip:hover,
  .filter-chip:focus-visible {
    border-color: rgba(159, 72, 39, 0.6);
    background: rgba(253, 247, 236, 0.85);
  }

  .filter-chip.is-active {
    border-color: var(--brand-1);
    color: #fff6ea;
    background: var(--brand-1);
  }

  .filter-chip.is-active i {
    color: #fff6ea;
  }

  .type-bericht {
    --type-color: #8b2019;
  }

  .type-meldung {
    --type-color: #274f55;
  }

  .type-ausschreibung {
    --type-color: #7b5b17;
  }

  .type-kurzmeldung {
    --type-color: #5c4b6b;
  }

  .result-status {
    margin: 0.75rem 0 0 !important;
    color: var(--ink-2) !important;
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }

  /* ---------- Zeitstrahl ---------- */

  .timeline {
    position: relative;
    margin-top: 1.5rem;
  }

  .timeline-svg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: visible;
    pointer-events: none;
  }

  .timeline-path-bg {
    fill: none;
    stroke: rgba(159, 72, 39, 0.2);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .timeline-path-progress {
    fill: none;
    stroke: var(--brand-1);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 5px rgba(159, 72, 39, 0.5));
    transition: stroke-dashoffset 120ms linear;
  }

  .timeline-track {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.9rem;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 2.75rem 1fr;
    align-items: start;
    opacity: 0;
    translate: 0 16px;
    perspective: 600px;
    transition: opacity 480ms ease, translate 480ms ease;
  }

  .timeline-item.is-revealed {
    opacity: 1;
    translate: 0 0;
  }

  .timeline-dot {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    justify-self: center;
    margin-top: 0.1rem;
