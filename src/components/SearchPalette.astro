---
import { officialSearchIndex } from '../data/search';

const serialized = JSON.stringify(officialSearchIndex);
---

<script type="application/json" data-search-index set:html={serialized}></script>

<div class="search-overlay" data-search-overlay hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-dialog" role="dialog" aria-modal="true" aria-label="Portal-Suche">
    <div class="search-field">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="m20 20-3.2-3.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        data-search-input
        placeholder="Suche nach Thema, Ort, Rolle, Regel…"
        aria-label="Suchbegriff"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-esc">Esc</kbd>
    </div>
    <ul class="search-results" data-search-results role="listbox" aria-label="Suchergebnisse"></ul>
    <p class="search-empty" data-search-empty hidden>Keine Treffer. Versuch einen anderen Begriff.</p>
  </div>
</div>

<script>
  interface SearchEntry {
    href: string;
    title: string;
    summary: string;
    group: string;
    keywords: string[];
  }

  function initializeSearchPalette() {
    const index = document.querySelector<HTMLScriptElement>('[data-search-index]');
    const overlay = document.querySelector<HTMLElement>('[data-search-overlay]');
    const input = document.querySelector<HTMLInputElement>('[data-search-input]');
    const results = document.querySelector<HTMLElement>('[data-search-results]');
    const empty = document.querySelector<HTMLElement>('[data-search-empty]');
    if (!index || !overlay || !input || !results || !empty) return;
    if (overlay.dataset.searchPaletteInitialized === 'true') return;
    overlay.dataset.searchPaletteInitialized = 'true';

    const entries = JSON.parse(index.textContent ?? '[]') as SearchEntry[];
    const controller = new AbortController();
    const listenerOptions = { signal: controller.signal };
    let activeIndex = -1;
    let current: SearchEntry[] = [];
    let lastFocus: HTMLElement | null = null;

    const normalize = (value: string) =>
      value
        .toLocaleLowerCase('de')
        .replace(/ä/g, 'ae')
        .replace(/ö/g, 'oe')
        .replace(/ü/g, 'ue')
        .replace(/ß/g, 'ss')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

    const render = (query: string) => {
      const q = normalize(query.trim());
      current = !q
        ? entries.slice(0, 40)
        : entries
            .filter((entry) => {
              const haystack = normalize(`${entry.title} ${entry.keywords.join(' ')}`);
              return haystack.includes(q);
            })
            .slice(0, 40);

      results.innerHTML = '';
      activeIndex = current.length ? 0 : -1;

      current.forEach((entry, entryIndex) => {
        const item = document.createElement('li');
        item.className = 'search-result';
        item.setAttribute('role', 'option');
        item.dataset.index = String(entryIndex);
        item.setAttribute('aria-selected', entryIndex === activeIndex ? 'true' : 'false');

        const link = document.createElement('a');
        link.href = entry.href;
        link.className = 'search-result__link';

        const title = document.createElement('span');
        title.className = 'search-result__title';
        title.textContent = entry.title;

        link.appendChild(title);
        item.appendChild(link);
        item.addEventListener('mousemove', () => setActive(entryIndex), listenerOptions);
        results.appendChild(item);
      });

      empty.hidden = current.length > 0;
    };

    const setActive = (index: number) => {
      activeIndex = index;
      const nodes = results.querySelectorAll('.search-result');
      nodes.forEach((node, nodeIndex) => {
        node.setAttribute('aria-selected', nodeIndex === index ? 'true' : 'false');
        if (nodeIndex === index) node.scrollIntoView({ block: 'nearest' });
      });
    };

    const go = (index: number) => {
      const entry = current[index];
      if (entry) window.location.href = entry.href;
    };

    const open = () => {
      if (!overlay.hidden) return;
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      overlay.hidden = false;
      document.body.classList.add('search-open');
      input.value = '';
      render('');
      window.requestAnimationFrame(() => input.focus());
    };

    const close = () => {
      if (overlay.hidden) return;
      overlay.hidden = true;
      document.body.classList.remove('search-open');
      lastFocus?.focus();
    };

    document.querySelectorAll('[data-search-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open();
      }, listenerOptions);
    });

    document.querySelectorAll('[data-search-close]').forEach((element) => {
      element.addEventListener('click', close, listenerOptions);
    });

    input.addEventListener('input', () => render(input.value), listenerOptions);

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (current.length) setActive((activeIndex + 1) % current.length);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (current.length) setActive((activeIndex - 1 + current.length) % current.length);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        if (activeIndex >= 0) go(activeIndex);
      }
    }, listenerOptions);

    document.addEventListener('keydown', (event) => {
      const key = event.key.toLowerCase();
      if ((event.metaKey || event.ctrlKey) && key === 'k') {
        event.preventDefault();
        overlay.hidden ? open() : close();
      } else if (event.key === 'Escape' && !overlay.hidden) {
        event.preventDefault();
        close();
      } else if (
        key === '/' &&
        overlay.hidden &&
        !/^(input|textarea|select)$/i.test(document.activeElement?.tagName ?? '')
      ) {
        event.preventDefault();
        open();
      }
    }, listenerOptions);

    document.addEventListener('astro:before-swap', () => controller.abort(), {
      once: true,
      signal: controller.signal,
    });
  }

  initializeSearchPalette();
  document.addEventListener('astro:page-load', initializeSearchPalette);
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    align-items: start;
    justify-items: center;
    padding: clamp(3.5rem, 12vh, 9rem) 1rem 2rem;
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 7, 5, 0.62);
    backdrop-filter: blur(3px);
    animation: search-fade 160ms ease;
  }

  .search-dialog {
    position: relative;
    width: min(640px, 100%);
    background: rgba(20, 14, 10, 0.98);
    border: 1px solid rgba(212, 183, 145, 0.28);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    animation: search-pop 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(212, 183, 145, 0.18);
    color: rgba(244, 233, 215, 0.75);
  }

  .search-field input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    color: rgba(244, 233, 215, 0.96);
    font: 600 1.05rem/1.3 'Source Sans 3', 'Segoe UI', sans-serif;
    outline: none;
  }

  .search-field input::placeholder {
    color: rgba(244, 233, 215, 0.45);
    font-weight: 500;
  }

  .search-esc {
    flex: 0 0 auto;
    font-family: 'Source Sans 3', 'Segoe UI', sans-serif;
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
    border: 1px solid rgba(212, 183, 145, 0.3);
    color: rgba(244, 233, 215, 0.7);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: min(52vh, 420px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .search-result__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.7rem;
    border-radius: 10px;
    text-decoration: none;
    color: rgba(244, 233, 215, 0.92);
  }

  .search-result__title {
    font-family: 'Source Sans 3', 'Segoe UI', sans-serif;
    font-weight: 600;
    line-height: 1.3;
  }

  .search-result[aria-selected='true'] .search-result__link {
    background: rgba(159, 72, 39, 0.28);
  }

  .search-empty {
    margin: 0;
    padding: 1.2rem 1rem 1.6rem;
    text-align: center;
    color: rgba(244, 233, 215, 0.6);
    font-family: 'Source Sans 3', 'Segoe UI', sans-serif;
  }

  .search-empty[hidden] {
    display: none;
  }

  :global(body.search-open) {
    overflow: hidden;
  }

  @keyframes search-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes search-pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-backdrop,
    .search-dialog {
      animation: none;
    }
  }
</style>
