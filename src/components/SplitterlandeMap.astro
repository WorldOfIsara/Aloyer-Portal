// Infotext pro Land für das Klick-Fenster: nutzt Einträge aus
// src/data/splitterlandeInfo.ts, fällt sonst auf einen neutralen
// Platzhalter im Ton der Akademie zurück.
interface CountryInfo {
  name: string;
  text: string;
  ruler?: string;
  href?: string;
  crestCandidates: string[];
}

const splitterlandeInfoByName = new Map(
  splitterlandeInfo.map((entry) => [entry.name, entry])
);

// Erzeugt einen URL-sicheren Dateinamen aus dem Ländernamen, z.B. für
// "L'Est d'Arc" -> "lest-d-arc".
const slugify = (name: string) =>
  name
    .toLowerCase()
    .replace(/[''`]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

// Wappen-Suchreihenfolge: zuerst die bereits vorhandenen Partner-Wappen unter
// images/ot/partner (.png), dann images/it/umland/wappen (.webp) für neu
// ergänzte Wappen. Existiert keine der Dateien, zeigt das Klick-Fenster
// automatisch den ⚜-Platzhalter.
const countryInfo: CountryInfo[] = regions.map((region) => {
  const entry = splitterlandeInfoByName.get(region.name);
  const fileSlug = slugify(region.name);
  return {
    name: region.name,
    text: entry?.text ? entry.text : fallbackInfoText,
    ruler: entry?.ruler,
    href: entry?.href,
    crestCandidates: [
      `/images/ot/partner/${fileSlug}.png`,
      `/images/it/umland/wappen/${fileSlug}.webp`,
    ],
  };
});

const infoByName = new Map(countryInfo.map((info) => [info.name, info]));

const {
  src = '/images/it/umland/splitterlande-karte.webp',
  alt = 'Historische Karte der Splitterlande im Stil einer mittelalterlichen Landkarte',
  caption = 'Die Splitterlande, wie sie in aloyischen Archiven verzeichnet sind. Einzelne Beschriftungen wurden nachträglich ergänzt oder berichtigt.',
} = Astro.props;
---

<figure class="splitterlande-map">
  <div class="splitterlande-map__frame">
    <img
      class="splitterlande-map__img"
      src={withBase(src)}
      alt={alt}
      width={1264}
      height={848}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />

    <svg
      class="splitterlande-map__regions"
      viewBox="0 0 1264 848"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {
        regions.map((region) => {
          const info = infoByName.get(region.name);
          return (
            <path
              class="splitterlande-map__region"
              data-name={region.name}
              data-group={region.group}
              data-info={info?.text}
              data-info-href={info?.href}
              data-info-crest={info?.crestCandidates.join('|')}
              data-info-ruler={info?.ruler}
              d={region.d}
              tabindex="0"
            />
          );
        })
      }
    </svg>

    <div class="splitterlande-map__layer">
      {
        labels.map((label) => (
          <div
            class="splitterlande-map__label"
            data-name={label.name}
            style={`left:${label.x}%;top:${label.y}%`}
          >
            <span class="splitterlande-map__label-text">
              {
                label.name.split('').map((char, i) => (
                  <span
                    class="splitterlande-map__label-char"
                    style={`--i:${i}`}
                  >
                    {char === ' ' ? ' ' : char}
                  </span>
                ))
              }
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <figcaption class="splitterlande-map__caption">{caption}</figcaption>

  <div class="splitterlande-map__modal" data-map-modal aria-hidden="true">
    <div class="splitterlande-map__modal-backdrop" data-map-modal-backdrop></div>
    <div
      class="splitterlande-map__modal-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="splitterlande-map-modal-title"
    >
      <button
        class="splitterlande-map__modal-close"
        type="button"
        data-map-modal-close
        aria-label="Fenster schließen"
      >
        ×
      </button>
      <div class="splitterlande-map__modal-header">
        <h3
          class="splitterlande-map__modal-title"
          id="splitterlande-map-modal-title"
          data-map-modal-title
        />
      </div>
      <div class="splitterlande-map__modal-body">
        <div class="splitterlande-map__modal-crest">
          <img data-map-modal-crest-img alt="" loading="lazy" />
          <span class="splitterlande-map__modal-crest-fallback" data-map-modal-crest-fallback>
            ⚜
          </span>
        </div>
        <div class="splitterlande-map__modal-content">
          <p class="splitterlande-map__modal-ruler" data-map-modal-ruler />
          <p class="splitterlande-map__modal-text" data-map-modal-text />
          <a class="splitterlande-map__modal-link" data-map-modal-link href="#">
            Mehr im Glossar
          </a>
        </div>
      </div>
    </div>
  </div>
</figure>

<style>
  .splitterlande-map {
    display: none;
    width: 100%;
    margin: 1.7rem auto 2.15rem;
    color: #332215;
    text-align: center;
  }

  .splitterlande-map__frame {
    position: relative;
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(92, 55, 31, 0.45);
    box-shadow: 0 14px 34px rgba(20, 11, 7, 0.28);
    line-height: 0;
  }

  .splitterlande-map__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .splitterlande-map__regions {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .splitterlande-map__region {
    fill: rgba(159, 72, 39, 0);
    stroke: rgba(159, 72, 39, 0);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    cursor: pointer;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    transition: fill 160ms ease, stroke 160ms ease;
  }

  /* Übrige Mitglieder einer Ländergruppe (z.B. Arcogne): zarter Hinweis-Rahmen */
  .splitterlande-map__region.is-group-hover {
    fill: rgba(230, 175, 76, 0.14);
    stroke: rgba(139, 42, 28, 0.4);
    stroke-width: 1.5;
  }

  .splitterlande-map__region:hover,
  .splitterlande-map__region:focus-visible,
  .splitterlande-map__region.is-group-hover:hover {
    fill: rgba(230, 175, 76, 0.32);
    stroke: rgba(139, 42, 28, 0.9);
    stroke-width: 3;
  }

  .splitterlande-map__layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .splitterlande-map__label {
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 1000ms ease;
  }

  .splitterlande-map__label.is-visible {
    opacity: 1;
    transition: opacity 0ms;
  }

  .splitterlande-map__label-text {
    position: relative;
    display: inline-flex;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(0.68rem, 1.35vw, 0.92rem);
    color: #2a1c10;
    padding: 0.1rem 0.4rem;
  }

  .splitterlande-map__label-text::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(227, 214, 130, 0.78);
    border-radius: 3px;
    box-shadow: 0 1px 3px rgba(20, 11, 7, 0.25);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 350ms ease;
  }

  .splitterlande-map__label.is-revealed .splitterlande-map__label-text::before {
    transform: scaleX(1);
  }

  .splitterlande-map__label-char {
    position: relative;
    display: inline-block;
    opacity: 0;
    transition: opacity 120ms ease;
    transition-delay: 0ms;
  }

  .splitterlande-map__label.is-revealed .splitterlande-map__label-char {
    opacity: 1;
    transition-delay: calc(350ms + var(--i) * 45ms);
  }

  .splitterlande-map__caption {
    max-width: 48rem;
    margin: 0.7rem auto 0;
    font-size: clamp(0.95rem, 1.6vw, 1.08rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.45;
  }

  @media (max-width: 720px) {
    .splitterlande-map__label-text {
      font-size: 0.62rem;
      padding: 0.08rem 0.3rem;
    }
  }

  /* Nur auf großen Bildschirmen anzeigen (kein Handy, kein Tablet). */
  @media (min-width: 1280px) {
    .splitterlande-map {
      display: block;
    }
  }

  .splitterlande-map__modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 200ms ease;
  }

  .splitterlande-map__modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .splitterlande-map__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 11, 7, 0.55);
    cursor: pointer;
  }

  .splitterlande-map__modal-panel {
    position: relative;
    width: min(90vw, 480px);
    margin: 1rem;
    padding: 1.6rem 1.85rem;
    background: rgba(248, 238, 214, 0.98);
    border: 1px solid rgba(92, 55, 31, 0.5);
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(20, 11, 7, 0.45);
    transform: scale(0.94);
    transition: transform 200ms ease;
    text-align: left;
  }

  .splitterlande-map__modal.is-open .splitterlande-map__modal-panel {
    transform: scale(1);
  }

  .splitterlande-map__modal-close {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    width: 1.9rem;
    height: 1.9rem;
    border: none;
    background: transparent;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    color: #4a2d1b;
    z-index: 1;
  }

  .splitterlande-map__modal-close:hover {
    color: #8b2a1c;
  }

  .splitterlande-map__modal-header {
    text-align: center;
    padding-right: 1.6rem;
  }

  .splitterlande-map__modal-body {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .splitterlande-map__modal-crest {
    position: relative;
    flex: 0 0 30%;
    width: 30%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    background: rgba(92, 55, 31, 0.08);
    border: 1px solid rgba(92, 55, 31, 0.3);
    border-radius: 6px;
    overflow: hidden;
  }

  .splitterlande-map__modal-crest img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .splitterlande-map__modal-crest img:not([src]),
  .splitterlande-map__modal-crest img[src=''] {
    display: none;
  }

  .splitterlande-map__modal-crest-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.8rem;
    color: rgba(92, 55, 31, 0.45);
  }

  .splitterlande-map__modal-content {
    flex: 0 0 70%;
    width: 70%;
    min-width: 0;
  }

  .splitterlande-map__modal-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0;
    color: #2a1c10;
  }

  .splitterlande-map__modal-ruler {
    display: none;
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    font-style: italic;
    color: #6b3a1f;
  }

  .splitterlande-map__modal-ruler.is-visible {
    display: block;
  }

  .splitterlande-map__modal-text {
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #3a2a1a;
  }

  .splitterlande-map__modal-link {
    display: none;
    font-size: 0.85rem;
    font-weight: 700;
    color: #8b2a1c;
    text-decoration: none;
  }

  .splitterlande-map__modal-link.is-visible {
    display: inline-block;
  }

  .splitterlande-map__modal-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  const FADE_OUT_MS = 1000;

  function initSplitterlandeMap() {
    document
      .querySelectorAll<HTMLElement>('.splitterlande-map')
      .forEach((map) => {
        if (map.dataset.hoverInitialized === 'true') {
          return;
        }
        map.dataset.hoverInitialized = 'true';

        const regions =
          map.querySelectorAll<SVGPathElement>('.splitterlande-map__region');
        const hideTimers = new WeakMap<HTMLElement, number>();

        const findLabel = (name: string) =>
          map.querySelector<HTMLElement>(
            `.splitterlande-map__label[data-name="${CSS.escape(name)}"]`
          );

        const showLabel = (label: HTMLElement) => {
          const pending = hideTimers.get(label);
          if (pending) {
            window.clearTimeout(pending);
            hideTimers.delete(label);
          }
          label.classList.add('is-visible');
          label.classList.add('is-revealed');
        };

        const hideLabel = (label: HTMLElement) => {
          label.classList.remove('is-visible');
          const timer = window.setTimeout(() => {
            label.classList.remove('is-revealed');
            hideTimers.delete(label);
          }, FADE_OUT_MS);
          hideTimers.set(label, timer);
        };

        // Länder, die zu einer Gruppe gehören (z.B. Arcogne), sollen beim
        // Hover gemeinsam hervorgehoben werden und zusätzlich das
        // Gruppen-Label anzeigen.
        const groupMembers = new Map<string, SVGPathElement[]>();
        regions.forEach((region) => {
          const group = region.dataset.group;
          if (!group) return;
          const list = groupMembers.get(group) ?? [];
          list.push(region);
          groupMembers.set(group, list);
        });

        regions.forEach((region) => {
          const name = region.dataset.name;
          if (!name) return;

          const label = findLabel(name);
          const group = region.dataset.group;
          const groupLabel = group ? findLabel(group) : null;
          const groupRegions = group ? groupMembers.get(group) ?? [] : [];

          const show = () => {
            if (label) showLabel(label);
            if (groupLabel) showLabel(groupLabel);
            groupRegions.forEach((r) => r.classList.add('is-group-hover'));
          };

          const hide = () => {
            if (label) hideLabel(label);
            if (groupLabel) hideLabel(groupLabel);
            groupRegions.forEach((r) => r.classList.remove('is-group-hover'));
          };

          region.addEventListener('mouseenter', show);
          region.addEventListener('focus', show);
          region.addEventListener('mouseleave', hide);
          region.addEventListener('blur', hide);
        });

        // Klick-Fenster mit Infotext zu einem Land.
        const modal = map.querySelector<HTMLElement>('[data-map-modal]');
        const modalTitle = map.querySelector<HTMLElement>(
          '[data-map-modal-title]'
        );
        const modalText = map.querySelector<HTMLElement>(
          '[data-map-modal-text]'
        );
        const modalRuler = map.querySelector<HTMLElement>(
          '[data-map-modal-ruler]'
        );
        const modalLink = map.querySelector<HTMLAnchorElement>(
          '[data-map-modal-link]'
        );
        const modalClose = map.querySelector<HTMLElement>(
          '[data-map-modal-close]'
        );
        const modalBackdrop = map.querySelector<HTMLElement>(
          '[data-map-modal-backdrop]'
        );
        const modalCrestImg = map.querySelector<HTMLImageElement>(
          '[data-map-modal-crest-img]'
        );
        const modalCrestFallback = map.querySelector<HTMLElement>(
          '[data-map-modal-crest-fallback]'
        );

        const openModal = (region: SVGPathElement) => {
          if (!modal || !modalTitle || !modalText || !modalLink) return;

          modalTitle.textContent = region.dataset.name ?? '';
          modalText.textContent =
            region.dataset.info ??
            'Zu diesem Land liegen der Akademie bislang keine gesicherten Aufzeichnungen vor.';

          if (modalRuler) {
            const ruler = region.dataset.infoRuler;
            if (ruler) {
              modalRuler.textContent = `Herrscher: ${ruler}`;
              modalRuler.classList.add('is-visible');
            } else {
              modalRuler.textContent = '';
              modalRuler.classList.remove('is-visible');
            }
          }

          const href = region.dataset.infoHref;
          if (href) {
            modalLink.href = href;
            modalLink.classList.add('is-visible');
          } else {
            modalLink.removeAttribute('href');
            modalLink.classList.remove('is-visible');
          }

          const candidates = (region.dataset.infoCrest ?? '')
            .split('|')
            .filter(Boolean);
          if (modalCrestImg && modalCrestFallback) {
            if (candidates.length > 0) {
              modalCrestFallback.style.display = 'none';
              let i = 0;
              const tryNext = () => {
                if (i >= candidates.length) {
                  modalCrestImg.removeAttribute('src');
                  modalCrestFallback.style.display = '';
                  return;
                }
                modalCrestImg.src = candidates[i];
                i += 1;
              };
              modalCrestImg.onerror = tryNext;
              tryNext();
            } else {
              modalCrestImg.removeAttribute('src');
              modalCrestFallback.style.display = '';
            }
          }

          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
        };

        const closeModal = () => {
          if (!modal) return;
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
        };

        regions.forEach((region) => {
          region.addEventListener('click', () => openModal(region));
          region.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              openModal(region);
            }
          });
        });

        modalClose?.addEventListener('click', closeModal);
        modalBackdrop?.addEventListener('click', closeModal);
        document.addEventListener('keydown', (event) => {
          if (
            event.key === 'Escape' &&
            modal?.classList.contains('is-open')
          ) {
            closeModal();
          }
        });
      });
  }

  initSplitterlandeMap();

  document.addEventListener('astro:page-load', initSplitterlandeMap);
</script>
