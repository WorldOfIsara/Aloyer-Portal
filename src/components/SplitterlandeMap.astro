interface MapLabel {
  name: string;
  x: number; // Prozent der Bildbreite
  y: number; // Prozent der Bildhöhe
}

interface MapRegion {
  name: string;
  d: string;
  group?: string; // z.B. "Arcogne" – Länder, die als Gruppe gemeinsam hervorgehoben werden
}

const fallbackInfoText =
  'Zu diesem Land liegen der Akademie bislang keine gesicherten Aufzeichnungen vor.';

interface Props {
  src?: string;
  alt?: string;
  caption?: string;
}

const withBase = (path: string) => {
  if (
    path.startsWith('http://') ||
    path.startsWith('https://') ||
    path.startsWith('//') ||
    path.startsWith(import.meta.env.BASE_URL)
  ) {
    return path;
  }

  return `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
};

